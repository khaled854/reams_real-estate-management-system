# =============================================================================
# AI Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Anthropic API key for the AI audit agent
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# REMS backend URL
REMS_URL=http://localhost:5000

# Test user credentials for the audit agent
ADMIN_EMAIL=admin@your-domain.local
ADMIN_PASSWORD=change_this_password

MANAGER_EMAIL=manager@your-domain.local
MANAGER_PASSWORD=change_this_password

EMPLOYEE_EMAIL=employee@your-domain.local
EMPLOYEE_PASSWORD=change_this_password
