# =============================================================================
# QA Test Environment Variables
# Copy this file to QA_REPORT/.env.test and fill in your values.
# NEVER commit .env.test to version control — it contains real credentials.
# =============================================================================

# Base URL of the running REMS backend
TEST_BASE_URL=http://localhost:5000/api/v1

# Admin test account
TEST_ADMIN_EMAIL=admin@company.local
TEST_ADMIN_PASS=your_admin_password_here

# Manager test account (optional — leave blank to skip manager tests)
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASS=

# Employee test account (optional)
TEST_EMPLOYEE_EMAIL=
TEST_EMPLOYEE_PASS=
