# =============================================================================
# Real Estate Management System — Backend Production Environment
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env on the production server
#   2. Fill in every CHANGE_THIS value
#   3. Run: npm run seed  (only needed on first deployment)
#   4. Run: npm start
#
# NEVER commit the .env file. Keep it on the server only.
# =============================================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0     # must stay 0.0.0.0 to accept LAN connections

# ── MySQL Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate_db
DB_USER=rems_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_CONNECTION_LIMIT=20

# ── JWT Authentication ───────────────────────────────────────
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_64_CHAR_HEX_STRING_HERE
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_CHAR_HEX_STRING_HERE
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie Security ──────────────────────────────────────────
# Must be a long random string — different from JWT secrets.
COOKIE_SECRET=GENERATE_ANOTHER_64_CHAR_HEX_STRING_HERE
# Set to "true" only when the server runs over HTTPS (not plain HTTP LAN).
FORCE_HTTPS=false

# ── CORS — LAN clients ───────────────────────────────────────
# Add the IP:PORT of every client computer that needs access.
# The server IP is usually the machine running Node.js.
# Run `ipconfig` on the server to find its LAN IP address.
#
# In production the frontend is served by Express from /public,
# so clients access both frontend and API on port 5000.
# Add all client IPs on port 5000:
CORS_ORIGINS=http://192.168.1.101:5000,http://192.168.1.102:5000,http://192.168.1.103:5000,http://192.168.1.104:5000

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ── Rate Limiting ─────────────────────────────────────────────
# 500 requests per 15 minutes per IP (more generous for LAN)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
