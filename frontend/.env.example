# =============================================================================
# Frontend environment variables
# Copy to .env and adjust for your environment.
# All vars MUST be prefixed with VITE_ to be exposed to the browser.
# =============================================================================

# ── API URL ───────────────────────────────────────────────────
#
# DEVELOPMENT (with Vite dev server proxy):
#   Use a relative path. Vite proxies /api/* → http://localhost:5000
#   VITE_API_BASE_URL=/api
#
# PRODUCTION (built bundle served from the backend Express server):
#   Not needed — the frontend is served by Express and axios uses /api
#   which resolves to the same host.
#
# LAN deployment (accessing the system from other PCs on the network):
#   Set this to the server machine's IP address.
#   VITE_API_BASE_URL=http://192.168.1.100:5000/api
#
VITE_API_BASE_URL=/api

# ── Backend origin for Vite proxy target ─────────────────────
# Only needed if the backend is NOT on localhost:5000.
# VITE_BACKEND_ORIGIN=http://192.168.1.100:5000

# ── Dev server port ───────────────────────────────────────────
VITE_PORT=3000

# ── Debug ─────────────────────────────────────────────────────
# Set to "true" to log all API requests to the browser console.
VITE_DEBUG_API=false
