# =============================================================================
# Real Estate Management System — .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/

# Environment files (NEVER commit real env files)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backend env files — contain real secrets
backend/.env
backend/.env.production
frontend/.env.production

# Logs — may contain sensitive runtime data
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
START_SYSTEM.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Uploads (keep folder structure, ignore contents)
uploads/properties/*
uploads/documents/*
uploads/avatars/*
uploads/videos/*
!uploads/**/.gitkeep

# Database backups
database/backups/*.sql
!database/backups/.gitkeep

# Production built frontend served by backend
backend/public/

# Coverage reports
coverage/

# Temp files
*.tmp
*.temp
*.cache

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# AI agent development directory — not part of deliverable
ai-agent/.venv/
ai-agent/reports/
ai-agent/.env

# Suitest test artifacts — credentials and logs contain sensitive data
.suitest/credentials.json
.suitest/logs/*.log
.suitest/suitest.db

# Semantic review artifacts
semantic-review/

# Suitest test artifacts
.suitest/

node_modules/
.env
output/
playwright-report/
test-results/
.suitest/

backend/uploads/
uploads/
_archive/
