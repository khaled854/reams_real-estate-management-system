# =============================================================================
# Real Estate Management System — .gitignore
# =============================================================================

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ─────────────────────────────────────────────
# frontend/dist is temporary (backend/public has the committed build)
frontend/dist/
frontend/.vite/
.vite/

# ── Environment files (NEVER commit secrets) ──────────────────
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.production
frontend/.env.production

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
backend/logs/*.log

# ── Uploaded media (user content, not source code) ────────────
backend/uploads/properties/*
backend/uploads/videos/*
backend/uploads/documents/*
backend/uploads/avatars/*
!backend/uploads/**/.gitkeep

# ── Database backups ──────────────────────────────────────────
database/backups/*.sql
!database/backups/.gitkeep

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.sw?

# ── Testing tools (development only) ─────────────────────────
test-results/
playwright-report/
blob-report/
/coverage/

# ── Development-only tools ────────────────────────────────────
ai-agent/
.suitest/
semantic-review/
output/
_archive/
QA_REPORT/

# ── Temp ──────────────────────────────────────────────────────
*.tmp
*.temp
*.cache
