# =============================================================================
# Real Estate Management System — Environment Variables
#
# HOW TO USE:
#   1. Copy backend/.env.example  → backend/.env  and fill in your values.
#   2. This root file is for reference only — the application reads
#      backend/.env at runtime.
#   NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=production
APP_NAME="Real Estate Management System"
APP_VERSION=1.0.0

# --- Backend Server ---
# PORT and HOST are read from backend/.env by the Express server.
PORT=5000
HOST=0.0.0.0

# --- Frontend API Base URL ---
# In PRODUCTION the React SPA is served by the same Express server, so the
# browser uses a same-origin relative path — no IP address needed here.
# The build script (scripts/build.js) writes VITE_API_BASE_URL=/api into
# frontend/.env.production automatically. Do NOT set this to a full URL
# like http://192.168.1.x:5000/api — that would cause CORS errors.
#
# DEVELOPMENT only (Vite dev server proxies /api → localhost:5000):
#   VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=/api

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate_db
DB_USER=rems_user
DB_PASSWORD=your_strong_password_here
DB_CONNECTION_LIMIT=10

# --- Authentication ---
# Generate unique secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: JWT_SECRET and JWT_REFRESH_SECRET MUST be different values.
#            If they are the same, a leaked access token can forge refresh tokens.
JWT_SECRET=replace_with_a_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# --- CORS ---
# In production the SPA and API share the same origin (same port 5000),
# so the browser sends NO cross-origin requests and CORS_ORIGINS only
# matters for non-browser clients (Postman, mobile apps, other tools).
# List the server's own LAN IP so API calls from Postman on another machine work.
#
# HOW TO FIND YOUR SERVER IP (Windows):
#   Run: ipconfig   → look for "IPv4 Address" under your network adapter
#
# Example:
#   CORS_ORIGINS=http://192.168.1.6:5000,http://localhost:5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- Rate Limiting ---
# Sliding window: max requests per window per IP on /api/* routes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs
