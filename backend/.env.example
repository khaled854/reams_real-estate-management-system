# =============================================================================
# Real Estate Management System — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# ── MySQL Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=real_estate_db
DB_USER=rems_user
DB_PASSWORD=your_strong_password_here
DB_CONNECTION_LIMIT=10

# ── JWT Authentication ───────────────────────────────────────
# Generate secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookie Security ──────────────────────────────────────────
# Secret used to sign the HttpOnly refresh-token cookie.
# Must be a long random string — different from JWT secrets.
COOKIE_SECRET=replace_with_another_64_char_random_hex_string
# Set to "true" only when the server runs over HTTPS (not plain HTTP LAN).
FORCE_HTTPS=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated LAN origins (no trailing slash).
# In dev, localhost is always allowed via LAN_PATTERN in cors.js.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# 500 MB per video. VideoUploader uses streaming fetch() to avoid browser OOM.
# Increase only if your storage and bandwidth allow it.
MAX_VIDEO_SIZE_MB=500

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Admin Seeding (used by: npm run seed) ────────────────────
# Set these before running seed-admin.js on a fresh installation.
# SEED_ADMIN_PASSWORD is required — the seed script will refuse to
# run if it is not set, preventing accidental insecure defaults.
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=ChangeThisBeforeFirstLogin!
SEED_ADMIN_FIRST=Admin
SEED_ADMIN_LAST=User
